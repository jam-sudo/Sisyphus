# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg

# Models (large binary artifacts)
models/**/*.json
models/**/*.bak
!models/**/.gitkeep
# Allow model manifests (small, authoritative provenance — see
# docs/science/model_manifest_schema.md)
!models/**/*.meta.json

# IDE
.vscode/
.idea/
*.swp
*.swo

# Environment
.env
.venv/
venv/

# OS
.DS_Store
Thumbs.db
*:Zone.Identifier

# Merge / patch conflict artifacts
*.orig
*.rej

# Testing
.pytest_cache/
.coverage
htmlcov/
.hypothesis/

# Linter / type-checker caches
.ruff_cache/
.mypy_cache/

# Jupyter
.ipynb_checkpoints/

# DrugBank derived data (license restricted, user must extract)
data/drugbank/

# DrugBank raw XML
full database.xml
.gstack/

# Transient logs
logs/

# Docking caches and derived structures (regenerable from scripts)
data/docking/

# sbi library auto-generated training telemetry (regenerable, noisy)
sbi-logs/

# Local tooling scratch/output (per-machine, regenerable — not repo-wide):
#   .playwright-mcp/ — browser-MCP screenshots, console logs, page snapshots
#   graphify-out/    — graphify knowledge-graph output (rebuilt via `graphify update .`)
.playwright-mcp/
graphify-out/

# Agent/session-local config (per-machine, not repo-wide)
.claude/

# Local-only Claude Code context (per-user agent memory; untracked by user request 2026-05-02)
CLAUDE.md

# Internal agent-operational docs (backlog, landmarks, plans, sub-backlogs, audit
# snapshots). Public-facing agent guidance lives in AGENTS.md; the
# docs/_internal/AGENT_INTERNAL.md superset is kept local-only because external
# readers don't need the day-to-day scratchpad (untracked by user request 2026-05-30).
docs/_internal/

# Manuscript / preprint / FDA-essay drafts and any binary document (local-only;
# binary, frequently revised — not version-tracked). The repo tracks ZERO binary
# documents (verified 2026-06-02), so these formats are ignored everywhere. To
# track a specific one, add a `!path/to/file.pdf` exception below this block.
*.docx
*.doc
*.pdf
*.odt
*.rtf
# (legacy explicit globs retained for clarity — now subsumed by the rules above)
Sisyphus_Preprint_*.docx
Sisyphus_Preprint_*.pdf
# Manuscript text artifacts that aren't binary (e.g. plaintext abstract). Targeted
# by name so legit tracked docs like Sisyphus_Design_v4.md are NOT shadowed.
Sisyphus_abstract*
Sisyphus_Preprint_*.txt

# Personal/admin documents (user-managed, never part of the PBPK codebase — 2026-05-31)
JaeMinYoon_*
# Career/job-search scratch in the repo root (personal, not project docs — 2026-06-12)
lab_jobs_entrylevel.md
resume_reframing_4jobs.md
pharmpy_contribution_plan.md
# Stray local plot output (regenerable scratch — 2026-06-12)
predict.png
