{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sisyphus External Holdout V1 frozen predictions",
  "type": "object",
  "required": [
    "cycle_id", "manifest_sha256", "audit_report_sha256", "git_sha",
    "source_tree_sha256", "dependency_lock_sha256", "artifact_inventory_sha256",
    "training_membership_sha256", "feature_schema_sha256", "solver_settings_sha256",
    "container_digest", "artifact_provenance", "rows"
  ],
  "properties": {
    "cycle_id": {"type": "string", "minLength": 1},
    "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "audit_report_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "git_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "source_tree_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "dependency_lock_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifact_inventory_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "training_membership_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "feature_schema_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "solver_settings_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "container_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "artifact_provenance": {
      "type": "object", "additionalProperties": {"type": "string"}
    },
    "rows": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "candidate_id", "arm_id", "dose_mg", "route", "primary_eligible",
          "meta_cmax_mg_l", "ml_cmax_mg_l", "meta_pi90_low_mg_l",
          "meta_pi90_high_mg_l", "interval_source", "execution_status"
        ],
        "properties": {
          "candidate_id": {"type": "string"}, "arm_id": {"type": "string"},
          "dose_mg": {"type": "number", "exclusiveMinimum": 0},
          "route": {"const": "oral"}, "primary_eligible": {"type": "boolean"},
          "meta_cmax_mg_l": {"type": "number", "exclusiveMinimum": 0},
          "ml_cmax_mg_l": {"type": "number", "exclusiveMinimum": 0},
          "engine_cmax_mg_l": {"type": ["number", "null"]},
          "clf_cmax_mg_l": {"type": ["number", "null"]},
          "vdss_cmax_mg_l": {"type": ["number", "null"]},
          "meta_pi90_low_mg_l": {"type": "number", "exclusiveMinimum": 0},
          "meta_pi90_high_mg_l": {"type": "number", "exclusiveMinimum": 0},
          "interval_source": {"const": "development_empirical_residual"},
          "execution_status": {"const": "ok"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
